# Discord application credentials
# Get these from https://discord.com/developers/applications
APP_ID=your_app_id_here
DISCORD_TOKEN=your_bot_token_here
PUBLIC_KEY=your_public_key_here

# Server-specific IDs. These live here rather than in the committed JSON
# config because the deploy runs `git pull`, which refuses to overwrite
# local edits to tracked files. Enable Developer Mode in Discord, then
# right-click the channel or role and choose Copy ID.

# Channel the daily putt.day no-show roll call posts to.
# Leave unset to keep the roll call disabled.
PUTT_CALLOUT_CHANNEL_ID=

# Role assigned by /smack. Leave unset to keep /smack disabled.
SMACK_ROLE_ID=
