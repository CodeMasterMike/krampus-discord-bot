# Local development only.
#
# On the VM this file is GENERATED by .github/workflows/deploy.yml from
# repository secrets on every deploy — edits made there are overwritten.
# To change a production value, update the secret under
# Settings > Secrets and variables > Actions and re-run the deploy.

# Discord application credentials (required).
# Get these from https://discord.com/developers/applications
APP_ID=your_app_id_here
DISCORD_TOKEN=your_bot_token_here
PUBLIC_KEY=your_public_key_here

# Server-specific IDs (optional). These live here rather than in the tracked
# JSON config, because the deploy runs `git pull` and refuses to overwrite
# local edits to tracked files. Enable Developer Mode in Discord, then
# right-click the channel or role and choose Copy ID.
#
# Leave either blank to keep its feature disabled.

# Channel the daily putt.day no-show roll call posts to.
PUTT_CALLOUT_CHANNEL_ID=

# Role assigned by /smack.
SMACK_ROLE_ID=
